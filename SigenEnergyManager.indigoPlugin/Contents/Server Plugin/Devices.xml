    <!-- ============================================================
         axleVppMonitor - Axle VPP export event monitoring
         ============================================================ -->
    <Device type="custom" id="axleVppMonitor">
        <Name>Axle VPP Monitor</Name>
        <ConfigUI>
            <SupportURL>https://github.com/Highsteads/SigenEnergyManager</SupportURL>
            <Field id="info" type="label">
                <Label>Shows Axle VPP export event status and state machine. No configuration required — managed automatically by the plugin.</Label>
            </Field>
        </ConfigUI>
        <States>
            <!-- Feed health (v5.55.0). The Axle poll returns "no event" for a
                 healthy quiet day AND for a hard failure, so without these two
                 a dead API is indistinguishable from a calm week — which is
                 exactly how a revoked token went unnoticed for six weeks. -->
            <State id="apiStatus">
                <ValueType>String</ValueType>
                <TriggerLabel>Axle API status changed</TriggerLabel>
                <ControlPageLabel>Axle API Status</ControlPageLabel>
            </State>
            <State id="apiLastOk">
                <ValueType>String</ValueType>
                <TriggerLabel>Axle API last-good time changed</TriggerLabel>
                <ControlPageLabel>Axle API Last Good Poll</ControlPageLabel>
            </State>
            <State id="vppStatus">
                <ValueType>String</ValueType>
                <TriggerLabel>VPP status changed</TriggerLabel>
                <ControlPageLabel>VPP Status</ControlPageLabel>
            </State>
            <State id="vppState">
                <ValueType>String</ValueType>
                <TriggerLabel>VPP state changed</TriggerLabel>
                <ControlPageLabel>VPP State</ControlPageLabel>
            </State>
            <State id="eventStartTime">
                <ValueType>String</ValueType>
                <TriggerLabel>Event start time changed</TriggerLabel>
                <ControlPageLabel>Event Start Time</ControlPageLabel>
            </State>
            <State id="eventEndTime">
                <ValueType>String</ValueType>
                <TriggerLabel>Event end time changed</TriggerLabel>
                <ControlPageLabel>Event End Time</ControlPageLabel>
            </State>
            <State id="preChargeRequired">
                <ValueType>String</ValueType>
                <TriggerLabel>Pre-charge SOC changed</TriggerLabel>
                <ControlPageLabel>Pre-Charge SOC Required (%)</ControlPageLabel>
            </State>
            <State id="estimatedEarnings">
                <ValueType>String</ValueType>
                <TriggerLabel>Estimated earnings changed</TriggerLabel>
                <ControlPageLabel>Estimated Earnings (GBP)</ControlPageLabel>
            </State>
            <State id="vppLastExportKwh">
                <ValueType>String</ValueType>
                <TriggerLabel>VPP export (running) changed</TriggerLabel>
                <ControlPageLabel>VPP Export Running (kWh)</ControlPageLabel>
            </State>
            <!-- Last VPP event summary (populated by _summarise_vpp_event
                 at each event's end, v5.18.2+). Lets the user see at a
                 glance whether Axle's strategy is doing the right thing
                 without having to read the JSONL file. -->
            <State id="lastVppDate">
                <ValueType>String</ValueType>
                <TriggerLabel>Last VPP event date changed</TriggerLabel>
                <ControlPageLabel>Last VPP Event Date</ControlPageLabel>
            </State>
